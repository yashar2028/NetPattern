{
  "name": "NetPattern",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "frontend" },
    "8000": { "label": "backend" }
  },
  "postAttachCommand": "echo 'Start NetPattern with ./codespaces_run.sh'"
}
