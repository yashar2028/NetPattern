# Production frontend: the built app served by nginx, which also proxies the API (same origin).
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# The app calls the API on its own origin (nginx forwards /v1 to the backend).
ENV VITE_API_BASE_URL=same-origin
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
