# Copy to .env (git-ignored) and adjust. docker compose reads .env automatically.

# PostgreSQL (official postgres:17 image)
POSTGRES_DB=netpattern_dev
POSTGRES_USER=netpattern
POSTGRES_PASSWORD=change-me-local-dev
# Host port; 5434 avoids clashing with mcpquick's 5433
POSTGRES_PORT=5434

# Backend (API + worker)
# Signs login tokens. Use a long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
AUTH_JWT_SECRET=change-me-to-a-long-random-value
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
BACKEND_PORT=8000
WORKER_HEARTBEAT_SECONDS=30

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
