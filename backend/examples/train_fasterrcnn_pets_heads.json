{
  "kind": "train",
  "pipeline": {
    "task": {"type": "detection.bbox"},
    "nodes": [
      {"id": "data", "type": "dataset", "params": {
        "format": "voc",
        "root": "oxford-pets",
        "annotations_dir": "annotations/xmls",
        "images_dir": "images",
        "split": {"strategy": "random"}
      }},
      {"id": "tf", "type": "transforms", "params": {
